/* TreeGov base stylesheet - token placeholders substituted by frontend_v3/theme.py */

QWidget {
    background: $BG;
    color: $FG;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QDialog, QWizard {
    background: $BG;
}

QFrame#leftPanel, QFrame#hudPanel {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QMainWindow::separator {
    background: $BORDER;
    width: 2px;
}

QSplitter::handle {
    background: $BORDER;
    height: 2px;
    width: 2px;
}

QMenuBar {
    background: $SURFACE;
    border-bottom: 1px solid $BORDER;
    font-size: 14px;
    font-weight: 500;
}

QMenuBar::item {
    background: transparent;
    color: $FG;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background: $ACCENT;
    color: $ACCENT_FG;
}

QMenu {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QMenu::item:selected {
    background: $ACCENT;
    color: $ACCENT_FG;
}

QMenu::item:disabled {
    color: $DISABLED;
}

QTabWidget::pane {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QTabBar::tab {
    background: $BG;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border: 1px solid $BORDER;
}

QTabBar::tab:selected {
    background: $SURFACE_ELEVATED;
    border-bottom-color: $SURFACE_ELEVATED;
}

QStatusBar {
    background: $SURFACE;
    border-top: 1px solid $BORDER;
}

QToolTip {
    background: $SURFACE_ELEVATED;
    color: $FG;
    border: 1px solid $BORDER;
}

/* Phase 3.11.a: governance/properties group boxes (HUD panel) */
QGroupBox {
    border: 1px solid $BORDER;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: $ACCENT;
}

QLabel#panelTitle {
    font-size: 15px;
    font-weight: bold;
    color: $ACCENT;
    margin-bottom: 4px;
}

QLabel#treeLargeWarning {
    color: $ACCENT;
    font-weight: bold;
}

QLabel[status="ok"] {
    color: $STATUS_OK;
    font-weight: bold;
}

QLabel[status="warn"] {
    color: $STATUS_WARN;
    font-weight: bold;
}

QLabel[status="crit"] {
    color: $STATUS_CRIT;
    font-weight: bold;
}

QLabel[status="unknown"] {
    color: $STATUS_UNKNOWN;
    font-weight: bold;
}

/* Phase 3.7.e (pre-1.0.0rc1): H1 — restore radio button indicator visibility.
   The global QWidget background rule paints over the native Windows
   indicator. Explicit ::indicator styling restores it using theme tokens
   (works in both light and dark). */
QRadioButton {
    spacing: 8px;
    background: transparent;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid $FG;
    background: $BG;
}
QRadioButton::indicator:checked {
    background: $ACCENT;
    border: 2px solid $ACCENT;
}
QRadioButton::indicator:hover {
    border: 2px solid $ACCENT;
}

QToolBar {
    background: $SURFACE_ELEVATED;
    border-bottom: 1px solid $BORDER;
    spacing: 4px;
    padding: 4px;
}

QToolBar QToolButton {
    padding: 1px;
    margin: 0px;
    border-radius: 4px;
}

QToolBar::separator {
    background: $BORDER;
}

QToolBar QToolButton {
    background: transparent;
    color: $FG;
}

QToolBar QToolButton:hover {
    background: $BORDER;
}

/* Phase 3.11.a: tree canvas and scrollbars integrated with the theme */
QGraphicsView {
    background: $BG;
    border: none;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: $SURFACE;
    border: none;
}

/* Phase 3.11.a: wizard legibility — labels/checkboxes follow the theme
   (a native bright background under Fusion left dark text unreadable) */
QWizardPage QLabel, QWizard QLabel {
    color: $FG;
    background: transparent;
    font-size: 13px;
}

QWizardPage QGroupBox {
    color: $FG;
    font-weight: bold;
}

QWizardPage QGroupBox::title {
    color: $ACCENT;
}

QWizardPage QCheckBox, QWizardPage QRadioButton {
    color: $FG;
}

/* Wizard title banner (EnginePage): theme-aware accent, legible over
   dark backgrounds. The ID selector outranks "QWizardPage QLabel".
   Border + spacing turn it into a proper page header. */
QLabel#wizardTitle {
    font-size: 18px;
    font-weight: bold;
    color: $ACCENT;
    border-bottom: 2px solid $BORDER;
    padding-bottom: 8px;
    margin-bottom: 12px;
}

/* Hotfix 3.11.a.1: wizard header and button box inherit the active theme
   (fixes dark header background in light theme and illegible text in dark
   theme). The ID selector QLabel#wizardTitle still outranks ::title.
   Ampliado: el área de contenido del wizard también se fuerza al tema
   (QWizard ya quedó cubierto por la regla base "QDialog, QWizard"). */
QWizard > QWidget {
    background-color: $BG;
}

QWizardPage {
    background-color: $BG;
}

QWizard::header {
    background-color: $SURFACE_ELEVATED;
    border-bottom: 1px solid $BORDER;
}

QWizard::title {
    color: $ACCENT;
    font-size: 16px;
    font-weight: bold;
}

QWizard::subtitle {
    color: $FG;
}

QDialogButtonBox {
    background-color: $SURFACE;
    border-top: 1px solid $BORDER;
}

QDialogButtonBox QPushButton {
    background-color: $BG;
    color: $FG;
    border: 1px solid $BORDER;
    padding: 4px 12px;
    border-radius: 4px;
}

QDialogButtonBox QPushButton:hover {
    background-color: $ACCENT;
    color: $ACCENT_FG;
}

/* Explicit wizard button rules: the wizard's button bar is a plain
   QWidget (not a QDialogButtonBox), so the QDialogButtonBox rules above
   do NOT reach the Next/Back/Finish/Cancel buttons. Without these rules
   the native Windows style paints them unthemed. */
QWizard QPushButton {
    background-color: $BG;
    color: $FG;
    border: 1px solid $BORDER;
    padding: 6px 16px;
    border-radius: 4px;
}

QWizard QPushButton:hover {
    background-color: $ACCENT;
    color: $ACCENT_FG;
}

/* Gains/reports table: modern flat look — subtle grid, elevated headers,
   accent selection. Alternate row colors require the widget flag
   (setAlternatingRowColors) to be enabled in reports_panel.py. */
QTableWidget {
    gridline-color: $BORDER;
    background-color: $SURFACE;
    alternate-background-color: $SURFACE_ELEVATED;
    selection-background-color: $ACCENT;
    selection-color: $ACCENT_FG;
}

QHeaderView::section {
    background-color: $SURFACE_ELEVATED;
    color: $FG;
    border: none;
    border-bottom: 1px solid $BORDER;
    border-right: 1px solid $BORDER;
    padding: 6px;
    font-weight: bold;
}

QTableWidget::item {
    padding: 4px;
}

/* Reports summary card: theme-token card (moved out of the inline
   stylesheet in reports_panel.py). QLabel inherits QFrame, so the
   children are reset to transparent explicitly. Inner spacing comes
   from the frame layout margins (15 px), not from QSS padding. */
QFrame#summaryCard {
    background-color: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
    border-radius: 6px;
}

QFrame#summaryCard QLabel {
    color: $FG;
    background: transparent;
}
