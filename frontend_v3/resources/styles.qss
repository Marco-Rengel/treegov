/* TreeGov base stylesheet - token placeholders substituted by frontend_v3/theme.py */

QWidget {
    background: $BG;
    color: $FG;
    font-size: 13px;
}

QFrame#leftPanel, QFrame#hudPanel {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QMainWindow::separator {
    background: $BORDER;
    width: 2px;
}

QSplitter::handle {
    background: $BORDER;
}

QMenuBar {
    background: $SURFACE;
    border-bottom: 1px solid $BORDER;
}

QMenuBar::item:selected {
    background: $ACCENT;
    color: $ACCENT_FG;
}

QMenu {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QMenu::item:selected {
    background: $ACCENT;
    color: $ACCENT_FG;
}

QMenu::item:disabled {
    color: $DISABLED;
}

QTabWidget::pane {
    border: 1px solid $BORDER;
}

QTabBar::tab {
    background: $SURFACE;
    padding: 6px 14px;
    border: 1px solid $BORDER;
}

QTabBar::tab:selected {
    background: $BG;
    border-bottom-color: $BG;
}

QStatusBar {
    background: $SURFACE;
    border-top: 1px solid $BORDER;
}

QToolTip {
    background: $SURFACE_ELEVATED;
    color: $FG;
    border: 1px solid $BORDER;
}

QLabel#panelTitle {
    font-weight: bold;
    color: $ACCENT;
}

QLabel#treeLargeWarning {
    color: $ACCENT;
    font-weight: bold;
}

QLabel#hudBody {
    padding: 4px;
}

QLabel[status="ok"] {
    color: $STATUS_OK;
    font-weight: bold;
}

QLabel[status="warn"] {
    color: $STATUS_WARN;
    font-weight: bold;
}

QLabel[status="crit"] {
    color: $STATUS_CRIT;
    font-weight: bold;
}

QLabel[status="unknown"] {
    color: $STATUS_UNKNOWN;
    font-weight: bold;
}

/* Phase 3.7.e (pre-1.0.0rc1): H1 — restore radio button indicator visibility.
   The global QWidget background rule paints over the native Windows
   indicator. Explicit ::indicator styling restores it using theme tokens
   (works in both light and dark). */
QRadioButton {
    spacing: 8px;
    background: transparent;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid $FG;
    background: $BG;
}
QRadioButton::indicator:checked {
    background: $ACCENT;
    border: 2px solid $ACCENT;
}
QRadioButton::indicator:hover {
    border: 2px solid $ACCENT;
}
