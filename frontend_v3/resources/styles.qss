/* TreeGov base stylesheet - token placeholders substituted by frontend_v3/theme.py */

QWidget {
    background: $BG;
    color: $FG;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QDialog, QWizard {
    background: $BG;
}

QFrame#leftPanel, QFrame#hudPanel {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QMainWindow::separator {
    background: $BORDER;
    width: 2px;
}

QSplitter::handle {
    background: $BORDER;
    height: 2px;
    width: 2px;
}

QMenuBar {
    background: $SURFACE;
    border-bottom: 1px solid $BORDER;
}

QMenuBar::item {
    background: transparent;
    color: $FG;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background: $ACCENT;
    color: $ACCENT_FG;
}

QMenu {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QMenu::item:selected {
    background: $ACCENT;
    color: $ACCENT_FG;
}

QMenu::item:disabled {
    color: $DISABLED;
}

QTabWidget::pane {
    background: $SURFACE_ELEVATED;
    border: 1px solid $BORDER;
}

QTabBar::tab {
    background: $BG;
    padding: 6px 14px;
    border: 1px solid $BORDER;
}

QTabBar::tab:selected {
    background: $SURFACE_ELEVATED;
    border-bottom-color: $SURFACE_ELEVATED;
}

QStatusBar {
    background: $SURFACE;
    border-top: 1px solid $BORDER;
}

QToolTip {
    background: $SURFACE_ELEVATED;
    color: $FG;
    border: 1px solid $BORDER;
}

/* Phase 3.11.a: governance/properties group boxes (HUD panel) */
QGroupBox {
    border: 1px solid $BORDER;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: $ACCENT;
}

QLabel#panelTitle {
    font-weight: bold;
    color: $ACCENT;
}

QLabel#treeLargeWarning {
    color: $ACCENT;
    font-weight: bold;
}

QLabel[status="ok"] {
    color: $STATUS_OK;
    font-weight: bold;
}

QLabel[status="warn"] {
    color: $STATUS_WARN;
    font-weight: bold;
}

QLabel[status="crit"] {
    color: $STATUS_CRIT;
    font-weight: bold;
}

QLabel[status="unknown"] {
    color: $STATUS_UNKNOWN;
    font-weight: bold;
}

/* Phase 3.7.e (pre-1.0.0rc1): H1 — restore radio button indicator visibility.
   The global QWidget background rule paints over the native Windows
   indicator. Explicit ::indicator styling restores it using theme tokens
   (works in both light and dark). */
QRadioButton {
    spacing: 8px;
    background: transparent;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid $FG;
    background: $BG;
}
QRadioButton::indicator:checked {
    background: $ACCENT;
    border: 2px solid $ACCENT;
}
QRadioButton::indicator:hover {
    border: 2px solid $ACCENT;
}

QToolBar {
    background: $SURFACE_ELEVATED;
    border-bottom: 1px solid $BORDER;
    spacing: 4px;
    padding: 4px;
}

QToolBar QToolButton {
    padding: 2px;
    margin: 0px;
    border-radius: 4px;
}

QToolBar::separator {
    background: $BORDER;
}

QToolBar QToolButton {
    background: transparent;
    color: $FG;
}

QToolBar QToolButton:hover {
    background: $BORDER;
}

/* Phase 3.11.a: tree canvas and scrollbars integrated with the theme */
QGraphicsView {
    background: $BG;
    border: none;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: $SURFACE;
    border: none;
}

/* Phase 3.11.a: wizard legibility — labels/checkboxes follow the theme
   (a native bright background under Fusion left dark text unreadable) */
QWizardPage QLabel, QWizard QLabel {
    color: $FG;
    background: transparent;
}

QWizardPage QGroupBox {
    color: $FG;
    font-weight: bold;
}

QWizardPage QGroupBox::title {
    color: $ACCENT;
}

QWizardPage QCheckBox, QWizardPage QRadioButton {
    color: $FG;
}

/* Wizard title banner (EnginePage): theme-aware accent, legible over
   dark backgrounds. The ID selector outranks "QWizardPage QLabel". */
QLabel#wizardTitle {
    font-size: 16px;
    font-weight: bold;
    color: $ACCENT;
}
