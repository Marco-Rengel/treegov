# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Entornos virtuales (todos ignorados explícitamente)
.venv*/
.venv/
.venv_linux/
.venv_3.14_backup/
venv/
env/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Datos confidenciales (nunca subir)
data/*

# Configuración local de OpenCode (por analista)
.opencode/

# Carpeta histórica (documentos pre-TreeGov)
archive/

# Backups temporales (generados durante diagnóstico)
.opencode-backup-*/
.opencode.disabled/

# Aider (herramienta local, no parte del proyecto)
.aider*
!.aider.conf.example.yml
!.aiderignore

# Archivos temporales de sesión (borradores de diff, estado parcial)
tmp_*
# npm (instalado por plugin de cache de OpenCode)
node_modules/
package.json
package-lock.json

# Secretos locales
.env
.env.*
*.pem
*.key

# Reportes de auditoría interna y diffs temporales UTF-8
audit_reports/
diff_*.txt
